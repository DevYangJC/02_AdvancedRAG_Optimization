# ================= LangChainRAG 后端配置(复制为 .env 并按需修改) =================

# --- 阿里云百炼 DashScope(全链路云端) ---
# 申请:登录 https://bailian.console.aliyun.com 开通"百炼大模型服务"→ API-KEY 管理创建
# 新用户有免费额度;Key 未配置时系统可正常注册登录与知识库管理,问答功能会提示配置
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# OpenAI 兼容模式端点(langchain-openai 直接接入)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型:qwen-plus(推荐性价比)/ qwen-turbo(更便宜)/ qwen-max(最强)
LLM_MODEL=qwen-plus
# 向量化模型 text-embedding-v3(1024 维,与 Qdrant collection 维度一致,勿改)
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# 重排序模型(DashScope 原生 rerank API)
RERANKER_MODEL=gte-rerank-v2
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# --- LLM 并发与重试 ---
LLM_MAX_CONCURRENCY=8
LLM_MAX_RETRIES=3

# --- 数据库(SQLite 开发期;生产切 MySQL/PostgreSQL 只需改此 URL) ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Qdrant 向量库(本地二进制,:6333) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=product_docs

# --- 检索参数 ---
RETRIEVE_DENSE_TOP_K=100
RERANK_TOP_N=6
RERANK_BATCH_SIZE=32

# --- 切分参数(中文友好) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- 缓存 ---
CACHE_TTL_HOURS=24
CACHE_CLEANUP_INTERVAL_MIN=30

# --- 认证 ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=14
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# --- 上传 ---
UPLOAD_MAX_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,xlsx,txt,md
UPLOAD_DIR=./data/uploads

# --- 会话 ---
HISTORY_MESSAGES=10

# --- 其他 ---
# Windows 控制台中文输出建议设置 PYTHONUTF8=1
